# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# WEB SEARCH (optional)
#
# Search works with NO configuration -- it falls back to DuckDuckGo, which
# needs no key. Everything below is an optional upgrade.
#
# The server tries them in this order and falls through on failure.
# ---------------------------------------------------------------------------

# 1. SearXNG -- self-hosted, free, unlimited. Best option. Run it with:
#      docker run -d -p 8080:8080 --name searxng searxng/searxng
#    Then enable the JSON format in its settings.yml and set:
# SEARXNG_URL="http://localhost:8080"

# 2. Google Custom Search -- 100 queries/day free, no credit card.
#    Key:  https://console.cloud.google.com/apis/credentials
#    CX:   https://programmablesearchengine.google.com  (set to search whole web)
# GOOGLE_CSE_KEY=""
# GOOGLE_CSE_CX=""

# 3. Brave -- no longer free. Requires a card as of Feb 2026.
# BRAVE_API_KEY=""
